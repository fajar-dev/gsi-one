# =========================================================
# GSI One - Environment Variables Template
# Salin file ini menjadi .env dan isi dengan nilai asli Anda
# cp .env.example .env
# =========================================================

# ----------------------------------------------------------
# SUPABASE CLOUD CONFIGURATION
# Dapatkan nilai ini dari: https://supabase.com/dashboard
# Project -> Settings -> API
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ----------------------------------------------------------
# ENVIRONMENT SELECTOR
# Nilai: emulator | simulator | production
# ----------------------------------------------------------
APP_ENV=emulator

# ----------------------------------------------------------
# API BASE URLs
# Sesuaikan dengan environment Anda
# ----------------------------------------------------------
API_BASE_URL_EMULATOR=http://10.0.2.2:3000
API_BASE_URL_SIMULATOR=http://localhost:3000
API_BASE_URL_PRODUCTION=https://grahasurvei.com
