# =========================================================
# GSI One Backend - Environment Variables Template
# Salin file ini menjadi backend/.env dan isi dengan nilai asli
# cp backend/.env.example backend/.env
# =========================================================

# ----------------------------------------------------------
# SUPABASE CLOUD CONFIGURATION
# Dapatkan nilai ini dari: https://supabase.com/dashboard
# Project -> Settings -> API
# ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ----------------------------------------------------------
# JWT SECRET - WAJIB DIISI
# Buat nilai acak yang aman dengan perintah berikut:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ----------------------------------------------------------
JWT_SECRET=

# ----------------------------------------------------------
# SERVER CONFIGURATION
# ----------------------------------------------------------
PORT=3000
