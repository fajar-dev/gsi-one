    "web": "webpack serve --mode development",
    "seed:storage": "node scripts/seed_storage.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/*.{js,cjs}\" App.tsx \"*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\" \"__tests__/**/*.{ts,tsx}\" \"scripts/*.{js,cjs}\" App.tsx \"*.js\"",
    "audit:architecture": "node scripts/audit_architecture.cjs",
    "check": "npm run audit:architecture && npm run audit:modules && npm run typecheck && npm run lint && npm run format:check && npm run test:ci",
    "build:web": "webpack --mode production",
    "audit:modules": "node scripts/audit_modules.cjs"
  },
